# cp .env.example .env 후 값 채우기 (docs/DEPLOY.md)

# 접속 도메인 (Caddy가 https 인증서 자동 발급)
DOMAIN=mystock.duckdns.org

# 로그인 비밀번호 (길고 어렵게)
APP_PASSWORD=

# 폰 푸시 연락처 (본인 메일)
VAPID_SUBJECT=mailto:me@example.com

# 선택: 로그인 토큰 서명 키. 비우면 /data/auth-secret에 자동 생성
# AUTH_SECRET=

# 선택: live(기본) / mock
# MARKET_DATA=live
